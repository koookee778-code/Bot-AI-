{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/qr",
      "destination": "https://bot-service-production-712e.up.railway.app/qr",
      "permanent": false
    },
    {
      "source": "/link",
      "destination": "https://bot-service-production-712e.up.railway.app/qr",
      "permanent": false
    },
    {
      "source": "/connect",
      "destination": "https://bot-service-production-712e.up.railway.app/qr",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://bot-service-production-712e.up.railway.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
